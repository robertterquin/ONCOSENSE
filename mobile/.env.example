# Copy this file to .env and fill in the values (mobile/.env is git-ignored).
# Use the same Supabase project as the Flutter app's root .env (SUPABASE_URL / SUPABASE_ANON_KEY).
# Only the anon key belongs here: it ships inside the app, and Row Level Security protects the data.
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
