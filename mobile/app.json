{
  "expo": {
    "name": "OncoSense",
    "slug": "oncosense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "oncosense",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.oncosense.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.oncosense.app",
      "adaptiveIcon": {
        "backgroundColor": "#2E1F66",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E1F66",
          "image": "./assets/images/splash.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "OncoSense uses your photos to set your profile picture.",
          "cameraPermission": "OncoSense uses the camera to take your profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#D81B60"
        }
      ],
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
